{
  "name": "matthew-wei-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "refresh:data": "node --use-env-proxy scripts/refresh-data.mjs",
    "dev": "node --use-env-proxy --watch server.mjs",
    "start": "node --use-env-proxy server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "test:live": "node --use-env-proxy test/live.mjs",
    "test:schedule": "node test/schedule-browser.mjs",
    "test:standalone-live": "node --use-env-proxy test/standalone-live.mjs",
    "test:preview": "node test/preview-browser.mjs",
    "build:website": "node scripts/build.mjs --website",
    "research:news": "node --use-env-proxy scripts/research-briefing.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "5.11.2",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "playwright-core": "1.64.0"
  }
}
